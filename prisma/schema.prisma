generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ListingCondition {
  NEW
  USED
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  SOLD
  REMOVED
}

enum PromotionStatus {
  PENDING
  PAID
  CANCELLED
  REVERSED
}

enum ReportReason {
  SCAM
  PROHIBITED_PRODUCT
  DUPLICATE
  FALSE_INFORMATION
  INAPPROPRIATE_CONTENT
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

model User {
  id           String           @id @default(cuid())
  name         String           @db.VarChar(100)
  email        String           @unique @db.VarChar(254)
  passwordHash String           @db.VarChar(255)
  phone        String?          @db.VarChar(15)
  whatsapp     String?          @db.VarChar(15)
  image        String?          @db.VarChar(2048)
  role         UserRole         @default(USER)
  status       UserStatus       @default(ACTIVE)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  listings     Listing[]
  favorites    Favorite[]
  reports      Report[]         @relation("ReportedBy")
  reviews      Report[]         @relation("ReviewedBy")
  contacts     ListingContact[]
  promotions   ListingPromotion[]
  buyerConversations ChatConversation[] @relation("ChatBuyer")
  sellerConversations ChatConversation[] @relation("ChatSeller")
  chatMessages ChatMessage[]

  @@index([status, createdAt])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @db.VarChar(80)
  slug      String    @unique @db.VarChar(100)
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  listings  Listing[]

  @@index([active, sortOrder])
}

model Listing {
  id                       String           @id @default(cuid())
  slug                     String           @unique @db.VarChar(160)
  title                    String           @db.VarChar(120)
  description              String           @db.Text
  price                    Decimal          @db.Decimal(12, 2)
  condition                ListingCondition
  status                   ListingStatus    @default(DRAFT)
  city                     String           @db.VarChar(100)
  state                    String           @db.Char(2)
  neighborhood             String           @db.VarChar(100)
  accountPlatform          String?          @db.VarChar(80)
  accountType              String?          @db.VarChar(30)
  accountPolicyUrl         String?          @db.VarChar(500)
  accountTransferConfirmed Boolean          @default(false)
  moderationNote           String?          @db.VarChar(500)
  views                    Int              @default(0)
  sellerId                 String
  categoryId               String
  seller                   User             @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category                 Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images                   ListingImage[]
  favorites                Favorite[]
  reports                  Report[]
  contacts                 ListingContact[]
  promotions               ListingPromotion[]
  conversations            ChatConversation[]
  featuredUntil            DateTime?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  // Portuguese full-text expression index is defined in the SQL migration.

  @@index([status, createdAt, id])
  @@index([categoryId, status, createdAt])
  @@index([sellerId, createdAt])
  @@index([state, city, status, createdAt])
  @@index([status, featuredUntil])
}

model ListingPromotion {
  id                String          @id @default(cuid())
  listingId         String
  sellerId          String
  status            PromotionStatus @default(PENDING)
  amountCents       Int
  durationDays      Int
  providerPaymentId String?         @unique @db.VarChar(100)
  pixCode           String?         @db.Text
  pixQrCodeBase64   String?         @db.Text
  expiresAt         DateTime?
  paidAt            DateTime?
  appliedUntil      DateTime?
  createdAt         DateTime        @default(now())
  listing           Listing         @relation(fields: [listingId], references: [id], onDelete: Restrict)
  seller            User            @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@index([listingId, createdAt])
  @@index([sellerId, createdAt])
}

model ListingImage {
  id         String  @id @default(cuid())
  listingId  String
  url        String  @db.VarChar(2048)
  position   Int
  storageKey String? @unique @db.VarChar(200)
  listing    Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, position])
}

model Favorite {
  userId    String
  listingId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([userId, createdAt])
  @@index([listingId])
}

model Report {
  id           String       @id @default(cuid())
  listingId    String
  reporterId   String?
  reviewedById String?
  reason       ReportReason
  details      String?      @db.VarChar(2000)
  status       ReportStatus @default(OPEN)
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  listing      Listing      @relation(fields: [listingId], references: [id], onDelete: Restrict)
  reporter     User?        @relation("ReportedBy", fields: [reporterId], references: [id], onDelete: SetNull)
  reviewedBy   User?        @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([listingId, reporterId])
  @@index([status, createdAt])
  @@index([listingId])
  @@index([reporterId])
  @@index([reviewedById])
}

model ListingContact {
  id        String   @id @default(cuid())
  listingId String
  userId    String?
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Restrict)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([listingId, createdAt])
  @@index([userId])
}

model ChatConversation {
  id        String   @id @default(cuid())
  listingId String
  buyerId   String
  sellerId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  buyerReadAt DateTime @default(now())
  sellerReadAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Restrict)
  buyer     User     @relation("ChatBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller    User     @relation("ChatSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  messages  ChatMessage[]

  @@unique([listingId, buyerId])
  @@index([buyerId, updatedAt])
  @@index([sellerId, updatedAt])
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String   @db.VarChar(2000)
  createdAt      DateTime @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt, id])
}

// Shared across application instances; no in-memory authentication limiter.
model AuthRateLimit {
  key       String   @id @db.VarChar(64)
  attempts  Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}
