generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ListingCondition {
  NEW
  USED
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  SOLD
  REMOVED
}

enum ReportReason {
  SCAM
  PROHIBITED_PRODUCT
  DUPLICATE
  FALSE_INFORMATION
  INAPPROPRIATE_CONTENT
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

model User {
  id           String       @id @default(cuid())
  name         String       @db.VarChar(100)
  email        String       @unique @db.VarChar(254)
  passwordHash String       @db.VarChar(255)
  phone        String?      @db.VarChar(15)
  whatsapp     String       @db.VarChar(15)
  image        String?      @db.VarChar(2048)
  role         UserRole     @default(USER)
  status       UserStatus   @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  listings     Listing[]
  favorites    Favorite[]
  reports      Report[]     @relation("ReportedBy")
  reviews      Report[]     @relation("ReviewedBy")
  contacts     ListingContact[]

  @@index([status, createdAt])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @db.VarChar(80)
  slug      String    @unique @db.VarChar(100)
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  listings  Listing[]

  @@index([active, sortOrder])
}

model Listing {
  id           String           @id @default(cuid())
  slug         String           @unique @db.VarChar(160)
  title        String           @db.VarChar(120)
  description  String           @db.Text
  price        Decimal          @db.Decimal(12, 2)
  condition    ListingCondition
  status       ListingStatus    @default(DRAFT)
  city         String           @db.VarChar(100)
  state        String           @db.Char(2)
  neighborhood String           @db.VarChar(100)
  views        Int              @default(0)
  sellerId     String
  categoryId   String
  seller       User             @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category     Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images       ListingImage[]
  favorites    Favorite[]
  reports      Report[]
  contacts     ListingContact[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status, createdAt, id])
  @@index([categoryId, status, createdAt])
  @@index([sellerId, createdAt])
  @@index([state, city, status, createdAt])
  // Portuguese full-text expression index is defined in the SQL migration.
}

model ListingImage {
  id        String  @id @default(cuid())
  listingId String
  url       String  @db.VarChar(2048)
  position  Int
  storageKey String? @unique @db.VarChar(200)
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, position])
}

model Favorite {
  userId    String
  listingId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([userId, createdAt])
  @@index([listingId])
}

model Report {
  id           String       @id @default(cuid())
  listingId    String
  reporterId   String?
  reviewedById String?
  reason       ReportReason
  details      String?      @db.VarChar(2000)
  status       ReportStatus @default(OPEN)
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  listing      Listing      @relation(fields: [listingId], references: [id], onDelete: Restrict)
  reporter     User?        @relation("ReportedBy", fields: [reporterId], references: [id], onDelete: SetNull)
  reviewedBy   User?        @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([listingId])
  @@index([reporterId])
  @@index([reviewedById])
  @@unique([listingId, reporterId])
}

model ListingContact {
  id        String   @id @default(cuid())
  listingId String
  userId    String?
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Restrict)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([listingId, createdAt])
  @@index([userId])
}

// Shared across application instances; no in-memory authentication limiter.
model AuthRateLimit {
  key       String   @id @db.VarChar(64)
  attempts  Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}
