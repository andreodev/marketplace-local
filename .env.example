DATABASE_URL="postgresql://marketplace:marketplace_dev@localhost:5434/marketplace?schema=public"
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
AUTH_URL="http://localhost:3000"

# local: development or a server with a persistent disk. s3: compatible object storage.
MEDIA_DRIVER="local"
MEDIA_LOCAL_DIR=".data/media"
# Fill these when MEDIA_DRIVER=s3. Credentials are server-only.
MEDIA_S3_ENDPOINT=""
MEDIA_S3_REGION="auto"
MEDIA_S3_BUCKET=""
MEDIA_S3_ACCESS_KEY_ID=""
MEDIA_S3_SECRET_ACCESS_KEY=""
MEDIA_S3_FORCE_PATH_STYLE="false"
